# ==============================================================================
# ENERGY SCADA DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Timezone
TZ=Asia/Jakarta
DISPLAY_TIMEZONE=Asia/Jakarta

# PostgreSQL Database Configuration
POSTGRES_DB=energy_scada
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=energy_secure_password_123!
DATABASE_URL=postgresql://energy_user:energy_secure_password_123!@database:5432/energy_scada

# Backend API Configuration
API_PORT=3000
INTERNAL_API_SECRET=energy-scada-internal-secret-token-change-in-prod

# Telemetry & Mode
# Source mode: simulation | device | off
ENERGY_SOURCE_MODE=simulation
TELEMETRY_INTERVAL_MS=1000
POLL_INTERVAL_MS=1000
HISTORY_INTERVAL_SECONDS=60
STALE_AFTER_SECONDS=10
HISTORY_RETENTION_DAYS=1
MIGRATE_ON_START=true

# Modbus TCP Gateway Configuration
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502

# Frontend Configuration
FE_PORT=8080

# Node-RED Configuration
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=node-red-credential-secret-key-32chars
